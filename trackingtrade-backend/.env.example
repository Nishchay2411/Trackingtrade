# ── Server ──
PORT=5001
NODE_ENV=development

# ── Database ──
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=trackingtrade
DB_PORT=3306
# Set DB_SSL=true when using cloud MySQL (Railway, Aiven, PlanetScale etc.)
DB_SSL=true

# ── JWT / Sessions ──
JWT_SECRET=your_super_secret_key_here_make_it_long_and_random
# Access token (sent in Authorization header, stored in localStorage) —
# kept short-lived on purpose so a leaked token expires fast.
ACCESS_TOKEN_EXPIRE=15m
# Refresh token (opaque, httpOnly cookie only, revocable in DB) lifetime, in days.
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google Login ──
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# (Application type: Web application). Add your frontend URL under
# "Authorized JavaScript origins". You only need the Client ID here —
# the flow used (Google Identity Services + ID token verification)
# never needs the Client Secret.
# This same value also goes in trackingtrade-frontend/js/config.js.
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# ── Email (Brevo HTTP API) ──
# Get this from: https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM=noreply@trackingtrade.com

# ── Frontend URL (used in email verification & reset links) ──
# Local dev example:    http://127.0.0.1:5500
# Production example:   https://trackingtrade.vercel.app
FRONTEND_URL=https://trackingtrade.vercel.app

# ── CORS ──
# Comma-separated list of origins allowed to call this API.
# Leave unset to use the built-in default (trackingtrade.vercel.app).
CORS_ORIGINS=https://trackingtrade.vercel.app,https://www.trackingtrade.vercel.app

# ── Logging ──
# One of: error, warn, info, debug. Defaults to "info" in production, "debug" otherwise.
LOG_LEVEL=info

# ── OpenAI (for AI Insights — optional) ──
# Leave as-is to use mock insights instead
OPENAI_API_KEY=your_openai_api_key_here
